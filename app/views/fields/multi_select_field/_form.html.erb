<div class="field-unit field-unit--multi_select field-unit--optional">
  <div class="field-unit__label">
    <label><%= field.attribute.to_s.humanize %></label>
  </div>
  <div class="field-unit__field">
    <% field.selectable_options.each do |option| %>
      <div class="multi-checkbox">
        <%= check_box_tag "pet[#{field.attribute}][]", option, field.data&.include?(option), id: "#{field.attribute}_#{option}" %>
        <%= label_tag "#{field.attribute}_#{option}", option.humanize %>
      </div>
    <% end %>
  </div>
</div>
