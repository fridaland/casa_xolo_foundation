<section class="site-hero">
  <div class="site-hero__inner">
    <h1 class="site-hero__title">We've secured a property!</h1>
    <h2 class="site-hero__heading">Help us fundraise to open our doors and bring hope to animals in need</h2>
    <p class="site-hero__body">Casa Xolo Foundation is building a home where rescued animals receive care, culture thrives, and community comes together to make a difference.</p>
    <div class="site-hero__actions">
      <a href="#" class="site-btn">Donate / Fundraise</a>
      <a href="#" class="site-btn site-btn--outline">Become a Foster</a>
      <a href="#" class="site-btn site-btn--outline-light">Volunteer</a>
    </div>
  </div>
</section>

<section class="site-pillars">
  <div class="site-section__inner">
    <div class="pillar-grid">
      <div class="pillar">
        <div class="pillar__icon">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </div>
        <h3 class="pillar__title">Animals</h3>
        <p class="pillar__desc">Providing rescue, rehabilitation, and loving homes for animals in need</p>
      </div>

      <div class="pillar">
        <div class="pillar__icon">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
        </div>
        <h3 class="pillar__title">Culture</h3>
        <p class="pillar__desc">Celebrating and preserving our heritage through compassionate action</p>
      </div>

      <div class="pillar">
        <div class="pillar__icon">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
          </svg>
        </div>
        <h3 class="pillar__title">Community</h3>
        <p class="pillar__desc">Building connections and support networks that strengthen our neighborhoods</p>
      </div>
    </div>
  </div>
</section>

<section class="site-section site-section--dark">
  <div class="site-section__inner">
    <div class="site-section__header">
      <h2 class="site-section__title">Meet Our Friends</h2>
      <p class="site-section__subtitle">Loving companions waiting for their forever homes</p>
    </div>

    <div class="pet-grid">
      <% @pets.each do |pet| %>
        <%= link_to pet_path(pet), class: "pet-card" do %>
          <% if pet.photos.attached? %>
            <%= image_tag pet.photos.first, alt: pet.name, class: "pet-card__photo" %>
          <% else %>
            <div class="pet-card__photo pet-card__photo--placeholder"></div>
          <% end %>
          <div class="pet-card__body">
            <div class="pet-card__name-row">
              <span class="pet-card__name"><%= pet.name %></span>
              <span class="site-badge"><%= pet.status&.capitalize %></span>
            </div>
            <% if pet.breed.present? %>
              <p class="pet-card__detail"><%= pet.breed %></p>
            <% end %>
            <% if pet.age.present? %>
              <p class="pet-card__detail"><%= pluralize(pet.age, "year") %></p>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="site-section__cta">
      <a href="#" class="site-btn">View All Adoptable Pets</a>
    </div>
  </div>
</section>

<section class="site-section site-section--charcoal">
  <div class="site-section__inner">
    <div class="site-section__header">
      <h2 class="site-section__title">Upcoming Events</h2>
      <p class="site-section__subtitle">Join us in making a difference</p>
    </div>

    <div class="event-grid">
      <% @events.each do |event| %>
        <div class="event-card">
          <h3 class="event-card__title"><%= event.name %></h3>
          <p class="event-card__meta"><%= event.event_date.strftime("%B %-d, %Y") %></p>
          <% if event.location.present? %>
            <p class="event-card__meta"><%= event.location %></p>
          <% end %>
          <% if event.description.present? %>
            <p class="event-card__desc"><%= event.description %></p>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="site-section__cta">
      <a href="#" class="site-btn">View All Events</a>
    </div>
  </div>
</section>
