<% content_for :body_class, "body--dark" %>

<section class="volunteer-hero">
  <h1 class="site-section__title">Volunteer With Us</h1>
  <p class="volunteer-hero__subtitle">
    Join our community of dedicated volunteers making a real difference in
    the lives of animals and our community.
  </p>
</section>

<section class="volunteer-content">
  <div class="volunteer-card">
    <%= image_tag "volunteering.png", class: "volunteer-card__image", alt: "Volunteers helping community" %>
    <div class="volunteer-card__body">
      <h2 class="volunteer-card__heading">Why Volunteer?</h2>
      <p class="volunteer-card__text">
        Volunteering with Casa Xolo Foundation is more than just giving your time—it's about being part
        of a movement that values compassion, community, and cultural connection. Whether you can spare
        a few hours a week or just want to help at special events, we have opportunities that fit your
        schedule and interests.
      </p>
      <p class="volunteer-card__text">
        As we prepare to open our new facility, we especially need volunteers to help with setup,
        construction, and organizational tasks. This is a unique opportunity to be part of our founding
        team and shape the future of our organization.
      </p>
    </div>
  </div>
</section>

<section class="volunteer-opportunities">
  <h2 class="volunteer-opportunities__title">Volunteer Opportunities</h2>
  <div class="volunteer-grid">
    <div class="volunteer-opp-card">
      <div class="volunteer-opp-card__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
      </div>
      <h3 class="volunteer-opp-card__title">Animal Care</h3>
      <p class="volunteer-opp-card__desc">Help with feeding, grooming, socializing, and exercising our animals</p>
    </div>

    <div class="volunteer-opp-card">
      <div class="volunteer-opp-card__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
        </svg>
      </div>
      <h3 class="volunteer-opp-card__title">Event Support</h3>
      <p class="volunteer-opp-card__desc">Assist with adoption events, fundraisers, and community outreach</p>
    </div>

    <div class="volunteer-opp-card">
      <div class="volunteer-opp-card__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
          <circle cx="12" cy="13" r="4"/>
        </svg>
      </div>
      <h3 class="volunteer-opp-card__title">Marketing &amp; Social Media</h3>
      <p class="volunteer-opp-card__desc">Create content, manage social media, and help spread our message</p>
    </div>

    <div class="volunteer-opp-card">
      <div class="volunteer-opp-card__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
      </div>
      <h3 class="volunteer-opp-card__title">Facility Maintenance</h3>
      <p class="volunteer-opp-card__desc">Help us build and maintain our new facility and grounds</p>
    </div>
  </div>
</section>

<section class="volunteer-requirements-section">
  <div class="volunteer-requirements">
    <h2 class="volunteer-requirements__title">Volunteer Requirements</h2>
    <div class="volunteer-requirements__columns">
      <div class="volunteer-requirements__column">
        <h3 class="volunteer-requirements__column-title">What You Need</h3>
        <ul class="volunteer-requirements__list">
          <li>Be at least 16 years old (or 12+ with parent/guardian)</li>
          <li>Complete volunteer orientation</li>
          <li>Commit to at least 8 hours per month</li>
          <li>Love for animals and community service</li>
        </ul>
      </div>
      <div class="volunteer-requirements__column">
        <h3 class="volunteer-requirements__column-title">What You Get</h3>
        <ul class="volunteer-requirements__list">
          <li>Training and ongoing support</li>
          <li>Volunteer appreciation events</li>
          <li>Community service hours documentation</li>
          <li>Opportunity to make lasting friendships</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="volunteer-cta">
  <a href="#" class="site-btn">Sign Up to Volunteer</a>
  <p class="volunteer-cta__contact">
    Questions? Email our volunteer coordinator at <a href="mailto:alondra@casaxolofoundation.org">alondra@casaxolofoundation.org</a>
  </p>
</section>
