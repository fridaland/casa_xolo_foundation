<div class="auth-layout">
  <div class="auth-card">
    <h1 class="auth-title">Casa Xolo Foundation</h1>
    <p class="auth-subtitle">Admin Portal</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-group">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, placeholder: "admin@casaxolo.org" %>
      </div>

      <div class="form-group">
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password %>
      </div>

      <%= f.submit "Sign In", class: "button button--block" %>
    <% end %>

    <div class="mt-6 text-center">
      <%= link_to "Forgot your password?",
            new_user_password_path,
            class: "button--link text-sm" %>
    </div>
  </div>
</div>
