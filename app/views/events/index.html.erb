<% content_for :title, "Events — Casa Xolo Foundation" %>
<% content_for :body_class, "body--dark" %>

<section class="events-hero">
  <h1 class="site-section__title">Events</h1>
  <p class="events-hero__subtitle">
    Join us for upcoming events and help make a difference in our community.
  </p>
</section>

<div class="events-page">
  <div class="events-page__inner">
    <% if @events.any? %>
      <div class="event-grid">
        <% @events.each do |event| %>
          <article class="event-card">
            <h2 class="event-card__title"><%= event.name %></h2>
            <p class="event-card__meta-row">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              <%= event.event_date.strftime("%B %-d, %Y") %>
            </p>
            <% if event.location.present? %>
              <p class="event-card__meta-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
                <%= event.location %>
              </p>
            <% end %>
            <% if event.description.present? %>
              <p class="event-card__desc"><%= event.description %></p>
            <% end %>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="events-empty">
        <p class="events-empty__text">No upcoming events at this time. Check back soon!</p>
      </div>
    <% end %>

    <div class="newsletter-card">
      <h2 class="newsletter-card__title">Stay Updated</h2>
      <p class="newsletter-card__desc">
        Want to be notified about upcoming events? Sign up for our newsletter to receive updates about adoption events, fundraisers, volunteer opportunities, and more.
      </p>
      <%= form_with url: newsletter_subscriptions_path, method: :post, class: "newsletter-form" do |f| %>
        <div class="newsletter-form__row">
          <%= f.email_field :email,
            placeholder: "Enter your email",
            class: "newsletter-form__input",
            "aria-label": "Email address",
            required: true %>
          <%= f.submit "Subscribe", class: "newsletter-form__btn" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
